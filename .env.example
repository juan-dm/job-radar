# Environment variables this app needs. Names only: never put real values here.
# To run locally: copy this file to .env.local (gitignored) and fill in the values.
# On Vercel: add the same names under Project > Settings > Environment Variables.

# Supabase: dashboard > Connect (Next.js), or Project Settings > API Keys.
# NEXT_PUBLIC_ means the value is built into the browser code, so anyone can see it.
# Both of these are public by design; Row Level Security protects the data.
# Never give a secret key (sb_secret_...) the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog: Settings > Project > General > Project API key (starts with phc_).
# Public by design. Set it on Vercel Production only; leave it out locally
# so your own testing isn't counted. Without it, analytics is switched off.
NEXT_PUBLIC_POSTHOG_KEY=
